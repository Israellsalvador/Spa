# Copie para .env e preencha:  cp .env.example .env

# Chave de sessão. Gere com:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Conta da administração, criada na primeira subida (entre em /entrar com ela).
ADMIN_EMAIL=dona@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# 1 = cookies só por HTTPS (use em produção, atrás do Nginx com certificado).
# 0 = para testar em http://localhost
COOKIE_SECURE=1

# 1 = está atrás de proxy reverso (Nginx). Mantenha 1.
BEHIND_PROXY=1
